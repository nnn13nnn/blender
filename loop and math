import bpy
import math




number_of_spheres = 30  
radius_of_spiral = 5   
height_step = 0.3       


for i in range(number_of_spheres):
    
    angle = i * 0.4
    
   
    x_pos = radius_of_spiral * math.cos(angle)
    y_pos = radius_of_spiral * math.sin(angle)
    
  
    z_pos = i * height_step
    
    
    bpy.ops.mesh.primitive_uv_sphere_add(
        radius=0.5, 
        location=(x_pos, y_pos, z_pos)
    )
    
   
